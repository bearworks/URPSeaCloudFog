Shader "Hidden/URPOcean/CausticDecal"
{
	// Projects the caustic texture _CausticRT (generated by CausticPass) onto the sea floor (opaque geometry below the water surface).
	// Fullscreen pass: samples scene depth to reconstruct world position, samples caustics aligned with the wave map by world XZ, additive blending.
	SubShader
	{
		Tags { "RenderPipeline" = "UniversalPipeline" }

		// Additive blend: only append caustic light contribution, never overwrite existing scene color
		Blend One One
		ZTest Always
		ZWrite Off
		Cull Off

		Pass
		{
			HLSLPROGRAM

			#pragma vertex vert_caustic_decal
			#pragma fragment frag_caustic_decal

			#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/Core.hlsl"
			#include "Packages/com.unity.render-pipelines.universal/ShaderLibrary/DeclareDepthTexture.hlsl"

			// Set every frame by CausticDecalPass (material uniforms, SRP Batcher compatible)
			CBUFFER_START(UnityPerMaterial)
				float _InvNeoScale;      // worldXZ -> WaveMap uv, i.e. NeoOcean.mainScale
				float _CausticScale;     // worldXZ -> CausticRT uv, i.e. _InvNeoScale * 2
				float _OceanLevel;       // Ocean level height, i.e. NeoOcean.oceanheight
				half4 _CausticColor;     // Caustic light color
				float _CausticIntensity; // Intensity
				float _CausticMaxDepth;  // Caustics fade out beyond this depth
				float _CausticSurfaceOffset; // Near-surface transition band width, avoids hard edges at the wave surface
				float _CausticTiling;    // Caustic tiling scale; =1 aligns with the ocean waves
			CBUFFER_END

			TEXTURE2D(_Map0);     // Wave displacement map (contains water surface height)
			SAMPLER(sampler_Map0);

			TEXTURE2D(_CausticRT); // Caustic intensity map
			SAMPLER(sampler_CausticRT);

			struct appdata_caustic_decal
			{
				float4 vertex : POSITION;
			};

			struct v2f_caustic_decal
			{
				float4 vertex : SV_POSITION;
			};

			v2f_caustic_decal vert_caustic_decal(appdata_caustic_decal v)
			{
				v2f_caustic_decal o;
				// Mesh already covers NDC [-1, 1], output directly
				o.vertex = float4(v.vertex.xy, 0.0, 1.0);
				return o;
			}

			// Water height sampling consistent with the ocean mesh (vert_MQ): 3 octaves, y channel
			float SampleWaterHeight(float2 worldXZ)
			{
				float2 tileableUvScale = worldXZ * _InvNeoScale;

				half4 c = SAMPLE_TEXTURE2D(_Map0, sampler_Map0, tileableUvScale);
				half4 c2 = SAMPLE_TEXTURE2D(_Map0, sampler_Map0, tileableUvScale * 2) * 0.5;
				half4 c3 = SAMPLE_TEXTURE2D(_Map0, sampler_Map0, tileableUvScale * 4) * 0.25;

				return _OceanLevel + c.y + c2.y + c3.y;
			}

			half4 frag_caustic_decal(v2f_caustic_decal i) : SV_Target
			{
				float2 screenUV = GetNormalizedScreenSpaceUV(i.vertex);

				float rawDepth = SampleSceneDepth(screenUV);

				// Sky pixels have no valid depth
			#if UNITY_REVERSED_Z
				if (rawDepth <= 1e-6)
					return half4(0, 0, 0, 0);
			#else
				if (rawDepth >= 1.0 - 1e-6)
					return half4(0, 0, 0, 0);
			#endif

				// Reconstruct world position (cf. Mobile-Scene-Decal: linear eye depth + view-space ray + unity_CameraToWorld;
				// does not rely on UNITY_MATRIX_I_VP/unity_MatrixInvVP - that matrix is unreliably populated in SRP)
				float eyeDepth = LinearEyeDepth(rawDepth, _ZBufferParams);

				// NDC on the SV_POSITION path matches the unflipped camera projection matrix (unity_CameraProjection)
				float2 ndc = screenUV * 2.0 - 1.0;
				float2 p11_22 = float2(unity_CameraProjection._11, unity_CameraProjection._22);
				float3 vpos = float3(ndc / p11_22, 1.0) * eyeDepth;

				float4 wpos = mul(unity_CameraToWorld, float4(vpos, 1.0));
				float3 worldPos = wpos.xyz;

				float waterHeight = SampleWaterHeight(worldPos.xz);
				float depthBelow = waterHeight - worldPos.y;

				// Only affect geometry below the water surface
				if (depthBelow <= 0.0)
					return half4(0, 0, 0, 0);

				// Caustic uv alignment derivation:
				// The generation side (Caustic.shader) samples _Map0[((p * 0.5 + 0.5) * 4)] at grid coordinate p,
				// i.e. the caustic pattern corresponds to the ocean's 3rd octave (uv * 4) component;
				// ocean 3rd octave uv = worldXZ * _InvNeoScale * 4, hence p = worldXZ * _InvNeoScale * 2;
				// CausticFixGaps extracts the middle 2x2, so CausticRT uv = p + 0.5.
				// _CausticTiling = 1 aligns strictly with the waves; scaling changes the pattern frequency (no longer phase-locked to wave crests)
				float2 causticUV = worldPos.xz * _CausticScale * _CausticTiling + 0.5;

				half4 caustic = SAMPLE_TEXTURE2D(_CausticRT, sampler_CausticRT, causticUV);

				// Fade in near the surface, fade out with depth
				float fadeIn = smoothstep(0.0, _CausticSurfaceOffset, depthBelow);
				float fadeOut = 1.0 - smoothstep(_CausticMaxDepth * 0.5, _CausticMaxDepth, depthBelow);

				// CausticRT rgb holds caustic intensity for 3 different IOR layers; keeping channel differences gives dispersive colored caustics
				half3 light = _CausticColor.rgb * caustic.rgb * (_CausticIntensity * fadeIn * fadeOut);

				return half4(light, 0);
			}

			ENDHLSL
		}
	}
}
